rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dados do sistema (agenda, caixa, etc.) - como já funciona hoje
    match /sistema/dados_barbearia {
      allow read, write: if true;
    }

    // Vencimento: o app só LÊ. Quem escreve é a função (Admin SDK ignora estas regras).
    match /sistema/assinatura {
      allow read: if true;
      allow write: if false;
    }

    // Todo o resto (inclusive a coleção "cobrancas") fica fechado para o navegador
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
